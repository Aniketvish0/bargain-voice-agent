# ═══════════════════════════════════════════════════════════════════════════
#  DOOT — environment
#
#  There are THREE separate places env vars live. Putting one in the wrong
#  place is the single most common way this build loses 30 minutes.
#
#    1. CONVEX DEPLOYMENT   →  npx convex env set KEY value
#                              NOT a local .env file. See the warning below.
#    2. bridge/.env         →  a real local file, read by python-dotenv
#    3. VERCEL              →  dashboard env vars (public, VITE_ prefixed)
#
#  This file is a reference for all three. Copy the relevant block.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1. CONVEX  —  set with:  npx convex env set KEY "value"
#
#  ⚠️ Convex functions CANNOT read a local .env file. If you put these in one,
#     process.env.X is undefined in your deployed httpActions and every
#     Telegram call 404s with a confusing "Not Found" from api.telegram.org.
#     Verify with:  npx convex env list
# ───────────────────────────────────────────────────────────────────────────

SARVAM_API_KEY=                  # from dashboard.sarvam.ai — top up ₹2000, free tier is ~8-12 calls
TELEGRAM_BOT_TOKEN=              # from @BotFather
TG_WEBHOOK_SECRET=               # you invent this. A-Z a-z 0-9 _ - only, 1-256 chars.
                                 #   openssl rand -hex 24
BRIDGE_URL=                      # https://<something>.ngrok-free.dev   (no trailing slash)
BRIDGE_SECRET=                   # you invent this. Must match bridge/.env exactly.
                                 #   openssl rand -hex 32
DASHBOARD_URL=                   # https://<project>.vercel.app  — for Telegram deep links
GOOGLE_PLACES_KEY=               # OPTIONAL. Omit and vendor discovery falls back to the OSM seed.
TELEGRAM_ALLOWED_USER_IDS=       # comma-separated. Lock the bot to your team during the build.


# ───────────────────────────────────────────────────────────────────────────
#  2. bridge/.env  —  a real file on the laptop running the bridge
# ───────────────────────────────────────────────────────────────────────────

SARVAM_API_KEY=                  # same key as above
TWILIO_ACCOUNT_SID=              # console.twilio.com
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=              # your US number in E.164, e.g. +14155550123
                                 #   MUST be non-Indian. Twilio blocks +91 → +91.
CONVEX_SITE_URL=                 # https://<deployment>.convex.site
                                 #   ⚠️ .convex.SITE for httpActions, NOT .convex.cloud
BRIDGE_SECRET=                   # must match the Convex value byte for byte
NGROK_HOST=                      # <something>.ngrok-free.dev  (host only, no scheme)

# Tuning — see BUILD-SPEC §6 and §13. These defaults are the tuned values.
STT_SAMPLE_RATE=16000            # ⚠️ NOT 8000. Halves the VAD frame to 32ms. Saves ~960ms/turn.
STT_MODE=transcribe              # transcribe | codemix — transcribe wins on numeral accuracy
STT_NEGATIVE_FRAMES_COUNT=6      # default 18 → 1152ms of dead air at 8kHz
STT_NEGATIVE_FRAMES_WINDOW=8
LLM_MODEL=sarvam-30b             # in-call turns
LLM_MAX_TOKENS=100
LLM_REASONING_EFFORT=null        # ⚠️ MANDATORY. Reasoning is ON by default and its tokens count
                                 #    toward max_tokens — the model burns the budget thinking and
                                 #    returns EMPTY CONTENT on a live call.
EXTRACT_MODEL=sarvam-105b        # offline extraction + summary. Never in the live loop.
TTS_MODEL=bulbul:v3
TTS_DEFAULT_VOICE=anushka
TTS_MIN_BUFFER_SIZE=25
ALLOW_INTERRUPTIONS=true         # flip to false in 5 seconds if the demo room is loud

# Guardrails — see BUILD-SPEC §15
MAX_VENDORS_PER_MISSION=3
MAX_CALL_DURATION_SEC=240
MAX_TURNS=16
DIAL_STAGGER_MS=500              # ⚠️ Sarvam rejects burst-opened sockets with close code 1003
CALL_WINDOW_START_IST=10
CALL_WINDOW_END_IST=20


# ───────────────────────────────────────────────────────────────────────────
#  3. VERCEL  —  dashboard only. These ship to the browser, so nothing secret.
# ───────────────────────────────────────────────────────────────────────────

VITE_CONVEX_URL=                 # https://<deployment>.convex.cloud
                                 #   ⚠️ .convex.CLOUD for the client, unlike the bridge


# ───────────────────────────────────────────────────────────────────────────
#  NOT USED — deliberately
# ───────────────────────────────────────────────────────────────────────────
#  DATABASE_URL / REDIS_URL / RECORDINGS_BUCKET
#    Convex is the database, the job scheduler, and the file storage. There is
#    no Postgres, no Redis, and no S3 bucket in this build.
#  Exotel / Plivo-India / Ozonetel / Knowlarity
#    All require Certificate of Incorporation + GST and 1-7 business days.
#    Not viable today. See BUILD-SPEC §10.
