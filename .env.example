# ── Sarvam AI ─────────────────────────────────────────────
# Get keys from the Sarvam dashboard. Voice Experience is the selected capability.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2          # streaming ASR
SARVAM_TTS_MODEL=bulbul:v2           # TTS
SARVAM_LLM_MODEL=sarvam-m            # dialogue + negotiation brain
# If Sarvam ships a bundled telephony/voice-agent runtime, prefer it and set:
# SARVAM_VOICE_AGENT_ID=

# ── Telephony (only if NOT using a Sarvam bundled runtime) ─
# India-native providers: Exotel / Plivo. Twilio also works.
TELEPHONY_PROVIDER=plivo             # plivo | exotel | twilio
TELEPHONY_AUTH_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_FROM_NUMBER=               # your outbound caller ID
MEDIA_STREAM_WS_URL=                 # public wss:// URL of your media bridge

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                  # from @BotFather
TELEGRAM_ALLOWED_USER_IDS=           # comma-separated; lock the bot to your account(s)

# ── Datastores ────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/doot
REDIS_URL=redis://localhost:6379

# ── Object storage for call recordings ────────────────────
RECORDINGS_BUCKET=
RECORDINGS_ACCESS_KEY=
RECORDINGS_SECRET_KEY=

# ── App config ────────────────────────────────────────────
MAX_PARALLEL_CALLS=3                 # bounded by telephony + Sarvam quotas
ESCALATION_TIMEOUT_SECONDS=25        # Checkpoint B wait before safe default
NEGOTIATION_MAX_ROUNDS=4             # stop haggling after N rounds
DEFAULT_LANG=hi
