# ═══════════════════════════════════════════════════════════════════════════
#  orydl — complete environment reference
#
#  Env vars live in FOUR places. Putting one in the wrong place is the single
#  most common way this build loses half an hour, because the failures are
#  silent — undefined vars produce 404s and empty replies, not errors.
#
#    1. CONVEX DEPLOYMENT  →  npx convex env set KEY "value"
#                             NOT a local file. Convex functions cannot read one.
#    2. bridge/.env        →  a real local file, read by python-dotenv
#    3. web/.env.local     →  Vite dashboard (public, VITE_ prefix)
#    4. frontend/.env.local → Next.js console (public, NEXT_PUBLIC_ prefix)
#
#  Plus CONVEX_DEPLOY_KEY in your shell for any CLI work.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  0. SHELL — for npx convex deploy / run / data / env / import
#
#  ⚠️ Must be a `prod:` key. A `preview:` key can deploy functions but CANNOT
#     set env vars, which blocks everything else.
#     Convex dashboard → switch to the Production deployment → Settings →
#     scroll to top of General → Generate Production Deploy Key.
# ───────────────────────────────────────────────────────────────────────────
CONVEX_DEPLOY_KEY=prod:careful-fly-767|...


# ───────────────────────────────────────────────────────────────────────────
#  1. CONVEX DEPLOYMENT   npx convex env set KEY "value"
#
#  Verify with:  npx convex env list
#                curl https://<dep>.convex.site/health
# ───────────────────────────────────────────────────────────────────────────

# REQUIRED — nothing works without these five
SARVAM_API_KEY=              # dashboard.sarvam.ai. Free tier ~8-12 calls; top up.
TELEGRAM_BOT_TOKEN=          # @BotFather
TG_WEBHOOK_SECRET=           # you invent it. A-Z a-z 0-9 _ - only.
                             #   openssl rand -hex 24
BRIDGE_SECRET=               # you invent it. MUST match bridge/.env byte for byte.
                             #   openssl rand -hex 32
BRIDGE_URL=                  # https://<host>.ngrok-free.app  (no trailing slash)
                             #   ⚠️ changes every time ngrok restarts

# REQUIRED for dialling
TWILIO_FROM_NUMBER=          # +16088177942 — must be NON-Indian; Twilio blocks +91→+91

# OPTIONAL
DASHBOARD_URL=               # https://<app>.vercel.app — used for /start deep links.
                             #   Unset = the bot sends no dashboard link.
GOOGLE_PLACES_KEY=           # unset = vendor discovery falls back to the OSM leads
                             #   table (82 rows). Perfectly fine.
TELEGRAM_ALLOWED_USER_IDS=   # comma-separated Telegram user ids. Unset = bot is
                             #   OPEN TO ANYONE who finds it. Set it during a demo.


# ───────────────────────────────────────────────────────────────────────────
#  2. bridge/.env   — the machine running the Pipecat process
# ───────────────────────────────────────────────────────────────────────────

# ── credentials ──
SARVAM_API_KEY=              # same key as Convex
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+16088177942
BRIDGE_SECRET=               # must match Convex exactly
CONVEX_SITE_URL=https://careful-fly-767.convex.site
                             #   ⚠️ .convex.SITE for httpActions.
                             #      .convex.CLOUD is the browser client and 404s here.
NGROK_HOST=                  # host only, no scheme: abc123.ngrok-free.app
PORT=7860

# ── STT tuning (BUILD-SPEC §6) ──
STT_SAMPLE_RATE=8000         # ⚠️ MUST match the transport. 16000 starves the VAD and
                             #    the agent goes deaf while every log looks clean.
STT_MODE=transcribe          # transcribe | codemix. transcribe wins on numerals,
                             #    and the number IS the deliverable.
STT_NEG_FRAMES=6             # default 18 → 1152ms of dead air before end-of-speech
STT_NEG_WINDOW=8             # default 24

# ── LLM ──
LLM_MODEL=sarvam-30b         # in-call turns; latency over depth
LLM_MAX_TOKENS=110
EXTRACT_MODEL=sarvam-105b    # offline extraction + summary. NEVER in the live loop.
                             #    reasoning_effort=null is hardcoded — see lib/sarvam.ts

# ── TTS ──
TTS_MIN_BUFFER=25            # ⚠️ NOT sent to Sarvam. Its own valid range is 50-200;
                             #    25 and 500+ are rejected with a 422 that kills the
                             #    whole config and produces total silence on the line.

# ── conversation policy (conversation.py) ──
ALLOW_INTERRUPTIONS=false    # true re-enables barge-in. Off by default: the callee's
                             #    "hello" on pickup used to cancel the greeting.
COALESCE_SECS=0.7            # how long to wait for them to keep talking before we answer
SILENCE_NUDGE_SECS=14        # one nudge, then a polite close
MAX_TURNS=16
MAX_CALL_DURATION_SEC=240
RING_TIMEOUT_SEC=30          # 12 in production; 30 while testing with a human


# ───────────────────────────────────────────────────────────────────────────
#  3. web/.env.local   — Vite dashboard. Public; nothing secret.
# ───────────────────────────────────────────────────────────────────────────
VITE_CONVEX_URL=https://careful-fly-767.convex.cloud
                             #   ⚠️ .convex.CLOUD here — the opposite of the bridge
VITE_DEV_TOKEN=              # optional: skip the ?t=<token> step during local dev


# ───────────────────────────────────────────────────────────────────────────
#  4. frontend/.env.local   — Next.js console. Public; nothing secret.
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=https://careful-fly-767.convex.cloud


# ───────────────────────────────────────────────────────────────────────────
#  NOT USED — deliberately, so nobody re-adds them
# ───────────────────────────────────────────────────────────────────────────
#  DATABASE_URL / REDIS_URL / RECORDINGS_BUCKET
#    Convex is the database, the scheduler AND the file storage. No Postgres,
#    no Redis, no S3.
#  Exotel / Plivo-India / Ozonetel / Knowlarity
#    All need Certificate of Incorporation + GST and 1-7 business days.
#    Twilio with a US caller ID is the only same-day path to +91. BUILD-SPEC §10.
#  OPENAI_API_KEY / any non-Sarvam LLM
#    Sarvam is the primary stack by design.
